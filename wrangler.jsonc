{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "northbharatjobs",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
 "assets": {
  "directory": "./public",
  "binding": "ASSETS",
  "not_found_handling": "single-page-application",
  "run_worker_first": [
    "/api/*",
    "/item/*",
    "/sitemap.xml",
    "/robots.txt"
  ]
},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "north_bharat_jobs",
      "database_id": "afd4241f-4e5c-4b86-ab0a-a870fd0c56f3"
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
